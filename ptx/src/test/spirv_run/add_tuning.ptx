.version 6.5
.target sm_30
.address_size 64

.visible .entry add_tuning(
	.param .u32 input,
	.param .u32 output
)
.maxntid 256, 1, 1
.minnctapersm 4
{
    .reg .u32 	    temp;
    .reg .u32 	    temp2;

	ld.param.u32 	temp, [input];
	add.u32		    temp2, temp, 1;
    st.param.u32    [output], temp2;
	ret;
}
