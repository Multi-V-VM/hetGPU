.version 6.5
.target sm_30
.address_size 64

.visible .func (.param.u32 output) incr (.param.u32 input);

.visible .entry call(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.global.u32   temp, [in_addr];
    .param.u32      incr_in;
    .param.u32      incr_out;
    st.param.b32    [incr_in], temp;
    call (incr_out), incr, (incr_in);
    ld.param.u32    temp, [incr_out];
    st.global.u32   [out_addr], temp;
    ret;
}

.visible .func (.param .u32 output) incr(
    .param .u32 input
)
{
    .reg .u32 	    temp;
    ld.param.u32    temp, [input];
    add.u32         temp, temp, 1;
    st.param.u32    [output], temp;
    ret;
}