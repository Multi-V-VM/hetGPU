.version 6.5
.target sm_30
.address_size 64

.visible .entry cvt_s16_s8(
	.param .s8 input,
	.param .s16 output
)
{
    .reg .b32 	    temp_16;
    .reg .b32 	    temp_8;

	// inline asm
	/*ptx_texBake_end*/
	// inline asm

	ld.param.s8 	temp_8, [input];
	cvt.s16.s8      temp_16, temp_8;
    st.param.s16    [output], temp_16;
	ret;
}
