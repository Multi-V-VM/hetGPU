.version 6.5
.target sm_30
.address_size 64

.visible .entry min(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .s32 	    temp1;
    .reg .s32 	    temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.s32          temp1, [in_addr];
    ld.s32          temp2, [in_addr+4];
	min.s32			temp1, temp1, temp2;
    st.s32          [out_addr], temp1;
	ret;
}
