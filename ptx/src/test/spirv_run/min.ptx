.version 6.5
.target sm_30
.address_size 64

.visible .entry min(
	.param .s32 input1,
	.param .s32 input2,
	.param .s32 output
)
{
    .reg .s32 	    temp1;
    .reg .s32 	    temp2;
    .reg .s32 	    result;

	ld.param.s32 	temp1, [input1];
    ld.param.s32 	temp2, [input2];
	min.s32			result, temp1, temp2;
    st.param.s32    [output], result;
	ret;
}
