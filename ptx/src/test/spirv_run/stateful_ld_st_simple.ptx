.version 6.5
.target sm_30
.address_size 64

.visible .entry stateful_ld_st_simple(
    .param .u32 input,
    .param .u32 output
)
{
    .reg .u32           in_addr;
    .reg .u32           out_addr;
    .reg .u32           in_addr2;
    .reg .u32           out_addr2;
    .reg .u32           temp;

    ld.param.u32        in_addr, [input];
    ld.param.u32        out_addr, [output];

    cvta.to.global.u32  in_addr2, in_addr;
    cvta.to.global.u32  out_addr2, out_addr;

    ld.global.u32       temp, [in_addr2];
    st.global.u32       [out_addr2], temp;
    ret;
}