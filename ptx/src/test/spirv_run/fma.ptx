.version 6.5
.target sm_30
.address_size 64

.visible .entry fma(
	.param .f32 input1,
	.param .f32 input2,
	.param .f32 input3,
	.param .f32 output
)
{
    .reg .f32 	    temp1;
    .reg .f32 	    temp2;
    .reg .f32 	    temp3;
    .reg .f32 	    result;

	ld.param.f32 	temp1, [input1];
    ld.param.f32 	temp2, [input2];
    ld.param.f32 	temp3, [input3];
	fma.rn.f32		result, temp1, temp2, temp3;
    st.param.f32    [output], result;
	ret;
}
