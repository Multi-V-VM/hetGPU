.version 6.5
.target sm_30
.address_size 64

.extern .func __assertfail
(
	.param .b32 __assertfail_param_0,
	.param .b32 __assertfail_param_1,
	.param .b32 __assertfail_param_2,
	.param .b32 __assertfail_param_3,
	.param .b32 __assertfail_param_4
);

.extern .func __assertfail
(
	.param .b32 __assertfail_param_0,
	.param .b32 __assertfail_param_1,
	.param .b32 __assertfail_param_2,
	.param .b32 __assertfail_param_3,
	.param .b32 __assertfail_param_4
);

.visible .entry assertfail(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp;
    .reg .u32 	    temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];



	{
	.reg .b32 temp_param_reg;
	mov.u32   temp_param_reg, 0;
	// <end>}
	.param .b32 param0;
	st.param.b32	[param0+0], in_addr;
	.param .b32 param1;
	st.param.b32	[param1+0], in_addr;
	.param .b32 param2;
	st.param.b32	[param2+0], temp_param_reg;
	.param .b32 param3;
	st.param.b32	[param3+0], in_addr;
	.param .b32 param4;
	st.param.b32	[param4+0], in_addr;
	call.uni 
	__assertfail, 
	(
	param0, 
	param1, 
	param2, 
	param3, 
	param4
	);
	
	//{
	}

    ld.u32          temp, [in_addr];
	add.u32		    temp2, temp, 1;
    st.u32          [out_addr], temp2;
	ret;
}


.extern .func __assertfail
(
	.param .b32 __assertfail_param_0,
	.param .b32 __assertfail_param_1,
	.param .b32 __assertfail_param_2,
	.param .b32 __assertfail_param_3,
	.param .b32 __assertfail_param_4
);
