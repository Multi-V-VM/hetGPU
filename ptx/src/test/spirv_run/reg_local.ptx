.version 6.5
.target sm_30
.address_size 64

.visible .entry reg_local(
	.param .u32 input,
	.param .u32 output
)
{
    .local .align 8 .b8 local_x[8];
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .b32 	    temp;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.global.u32   temp, [in_addr];
    st.u32          [local_x], temp + 1;
    ld.u32          temp, [local_x+0];
    st.global.u32   [out_addr+0], temp;
	ret;
}