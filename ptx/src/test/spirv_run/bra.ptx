.version 6.5
.target sm_30
.address_size 64

.visible .entry bra(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp;
    .reg .u32 	    temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.u32          temp, [in_addr];
	bra case1;
case1:
    add.u32         temp2, temp, 1;
    bra case3;
case2:
    add.u32         temp2, temp, 2;
case3:
    st.u32          [out_addr], temp2;
	ret;
}
