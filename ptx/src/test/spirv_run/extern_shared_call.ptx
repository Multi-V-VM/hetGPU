.version 6.5
.target sm_30
.address_size 64

.extern .shared .align 4 .b32 shared_mem[];

.func incr_shared_2_global()
{
    .reg .u32 	    temp;
    ld.shared.u32   temp, [shared_mem];
    add.u32         temp, temp, 2;
    st.shared.u32    [shared_mem], temp;
    ret;
}


.visible .entry extern_shared_call(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	        in_addr;
    .reg .u32 	        out_addr;
    .reg .u32 	        temp;

	ld.param.u32 	    in_addr, [input];
    ld.param.u32 	    out_addr, [output];

    ld.global.u32       temp, [in_addr];
    st.shared.u32       [shared_mem], temp;
    call incr_shared_2_global;
    ld.shared.u32       temp, [shared_mem];
    st.global.u32       [out_addr], temp;
	ret;
}