.version 6.5
.target sm_30
.address_size 64

.extern .func  (.param .align 16 .b8 func_retval0[16]) foobar
(
	.param .b32 extern_func
)
;

.visible .entry extern_func(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp;
    .reg .u32 	    temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.global.u32   temp, [in_addr];

	{
        .param .b32 param0;
        st.param.b32	[param0+0], temp;
        .param .align 16 .b8 retval0[16];
        call.uni (retval0) ,
        foobar ,
        (
        param0
        );
        ld.param.u32    temp2, [retval0];
	}
    st.u32          [out_addr], temp2;
	ret;
}
