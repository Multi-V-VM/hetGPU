.version 6.5
.target sm_30
.address_size 64

.visible .entry cvt_sat_s_u(
	.param .s32 input,
	.param .s32 output
)
{
    .reg .s32 	    temp;
    .reg .u32       temp2;
    .reg .s32 	    temp3;

	ld.param.s32 	temp, [input];
	cvt.sat.u32.s32	temp2, temp;
	cvt.s32.u32		temp3, temp2;
    st.param.s32    [output], temp3;
	ret;
}
