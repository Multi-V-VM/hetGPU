.version 6.5
.target sm_30
.address_size 64

.visible .entry clz(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .b32       temp;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.b32          temp, [in_addr];
	clz.b32         temp, temp;
    st.b32          [out_addr], temp;
	ret;
}
