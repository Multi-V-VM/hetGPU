.version 6.5
.target sm_30
.address_size 64

.visible .entry pred_not(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp;
    .reg .u32 	    temp2;
    .reg .u32 	    temp3;
    .reg .pred 	    pred;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.u32          temp, [in_addr];
    ld.u32          temp2, [in_addr + 8];
	setp.lt.u32		pred, temp, temp2;
    not.pred        pred, pred;
    @pred mov.u32   temp3, 1;
    @!pred mov.u32  temp3, 2;
    st.u32          [out_addr], temp3;
	ret;
}
