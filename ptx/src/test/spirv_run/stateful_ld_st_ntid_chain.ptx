.version 6.5
.target sm_30
.address_size 64

.visible .entry stateful_ld_st_ntid_chain(
    .param .u32 input,
    .param .u32 output
)
{
    .reg .b32           in_addr1;
    .reg .b32           in_addr2;
    .reg .b32           in_addr3;
    .reg .b32           out_addr1;
    .reg .b32           out_addr2;
    .reg .b32           out_addr3;
    .reg .u32           tid_32;
    .reg .u32           tid_64;
    .reg .u32           temp;

    ld.param.u32        in_addr1, [input];
    ld.param.u32        out_addr1, [output];

    cvta.to.global.u32  in_addr2, in_addr1;
    cvta.to.global.u32  out_addr2, out_addr1;

    mov.u32             tid_32, %tid.x;
    cvt.u32.u32         tid_64, tid_32;

    add.u32             in_addr3, in_addr2, tid_64;
    add.u32             out_addr3, out_addr2, tid_64;

    ld.global.u32       temp, [in_addr3];
    st.global.u32       [out_addr3], temp;
    ret;
}