.version 6.5
.target sm_30
.address_size 64

.visible .entry setp(
	.param .u32 input1,
	.param .u32 input2,
	.param .u32 output
)
{
    .reg .u32 	    temp;
    .reg .u32 	    temp2;
    .reg .u32 	    temp3;
    .reg .pred 	    pred;

	ld.param.u32 	temp, [input1];
    ld.param.u32 	temp2, [input2];
	setp.lt.u32		pred, temp, temp2;
    @pred mov.u32   temp3, 1;
    @!pred mov.u32  temp3, 2;
    st.param.u32    [output], temp3;
	ret;
}
