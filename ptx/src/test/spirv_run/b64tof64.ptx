.version 6.5
.target sm_30
.address_size 64

.visible .entry b64tof64(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .f32 	    in_addr_f;
    .reg .b32 	    in_addr;
    .reg .u32 	    out_addr;

    .reg.u32        temp;

	ld.param.f32 	in_addr_f, [input];
    ld.param.u32 	out_addr, [output];

    mov.b32         in_addr, in_addr_f;

    ld.u32          temp, [in_addr];
    st.u32          [out_addr], temp;

	ret;
}
