.version 6.5
.target sm_30
.address_size 64

.visible .entry ntid(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    in_val;
    .reg .u32 	    global_count;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.u32          in_val, [in_addr];
    mov.u32         global_count, %ntid.x;
	add.u32		    in_val, in_val, global_count;
    st.u32          [out_addr], in_val;
	ret;
}
