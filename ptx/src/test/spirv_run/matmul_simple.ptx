.version 6.5
.target sm_30
.address_size 64

.visible .entry matmul_simple(
	.param .u64 input_a,
	.param .u64 input_b,
	.param .u64 output
)
{
	.reg .u64 	    a_addr;
	.reg .u64 	    b_addr;
	.reg .u64 	    out_addr;
	.reg .s32 	    a_val;
	.reg .s32 	    b_val;
	.reg .s32 	    prod;

	ld.param.u64 	a_addr, [input_a];
	ld.param.u64 	b_addr, [input_b];
	ld.param.u64 	out_addr, [output];

	// Simple element-wise multiplication for now
	// This will be lifted to matrix multiplication in TOSA
	ld.s32          a_val, [a_addr];
	ld.s32          b_val, [b_addr];
	mul.lo.s32      prod, a_val, b_val;
	st.s32          [out_addr], prod;
	ret;
}