.version 6.5
.target sm_30
.address_size 64

.visible .entry mad_s32(
	.param .s32 input1,
	.param .s32 input2,
	.param .s32 input3,
	.param .s32 output1,
	.param .s32 output2,
	.param .s32 output3
)
{
    .reg .s32 	    dst;
    .reg .s32 	    src1;
    .reg .s32 	    src2;
    .reg .s32 	    src3;

	ld.param.s32    src1, [input1];
    ld.param.s32    src2, [input2];
    ld.param.s32    src3, [input3];
	mad.lo.s32      dst, src1, src2, src3;
    st.param.s32    [output1], dst;
    st.param.s32    [output2], dst;
    st.param.s32    [output3], dst;
	ret;
}
