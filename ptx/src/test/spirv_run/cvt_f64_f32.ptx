.version 6.5
.target sm_30
.address_size 64

.visible .entry cvt_f64_f32(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .f32 	    temp_f32;
    .reg .f32 	    temp_f64;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.global.f32   temp_f32, [in_addr];
	cvt.ftz.f32.f32 temp_f64, temp_f32;
    st.f32          [out_addr], temp_f64;
	ret;
}
