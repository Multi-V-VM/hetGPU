.version 6.5
.target sm_30
.address_size 64

.visible .entry sub(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp;
    .reg .u32 	    temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.u32          temp, [in_addr];
	sub.u32		    temp2, temp, 1;
    st.u32          [out_addr], temp2;
	ret;
}
