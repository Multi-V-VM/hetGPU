.version 6.5
.target sm_30
.address_size 64

.visible .entry cvt_s32_f32(
	.param .f32 input1,
	.param .f32 input2,
	.param .s32 output1,
	.param .s32 output2
)
{
    .reg .b32 	            temp1;
    .reg .b32 	            temp2;

	ld.param.f32 	        temp1, [input1];
    ld.param.f32 	        temp2, [input2];
    cvt.rpi.ftz.s32.f32     temp1, temp1;
    cvt.rpi.ftz.s32.f32     temp2, temp2;
    st.param.s32            [output1], temp1;
    st.param.s32            [output2], temp2;
    ret;
}
