.version 6.5
.target sm_30
.address_size 64

.func (.reg .f32 out) foobar(.reg .f32 x, .reg .f32 y)
{
    add.f32     out, x, y;
    ret;
}

.visible .entry func_ptr(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp;
    .reg .u32 	    temp2;
    .reg .u32 	    f_addr;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.u32          temp, [in_addr];
	add.u32		    temp2, temp, 1;
    mov.u32         f_addr, foobar;
    add.u32		    temp2, temp2, f_addr;
    st.u32          [out_addr], temp2;
	ret;
}
