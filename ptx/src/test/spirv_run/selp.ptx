.version 6.5
.target sm_30
.address_size 64

.visible .entry selp(
	.param .u16 input1,
	.param .u16 input2,
	.param .u16 output
)
{
    .reg .u16 	    temp1;
    .reg .u16 	    temp2;
    .reg .u16 	    result;

	ld.param.u16 	temp1, [input1];
    ld.param.u16 	temp2, [input2];
    selp.u16   		result, temp1, temp2, 0;
    st.param.u16    [output], result;
	ret;
}
