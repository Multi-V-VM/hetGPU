.version 6.5
.target sm_30
.address_size 64

.visible .entry mul_wide(
	.param .s32 input1,
	.param .s32 input2,
	.param .s64 output
)
{
    .reg .s32 	    inp1;
    .reg .s32 	    inp2;
    .reg .s64 	    result;

	ld.param.s32 	inp1, [input1];
    ld.param.s32 	inp2, [input2];
	mul.wide.s32    result, inp1, inp2;
    st.param.s64    [output], result;
	ret;
}
