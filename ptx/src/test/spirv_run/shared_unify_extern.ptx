.version 6.5
.target sm_30
.address_size 64

.extern .shared .b32 shared_ex[];
.shared .b32 shared_mod[4];

.func (.reg .b32 out) add()
{
    .reg .u32 	    temp1;
    .reg .u32 	    temp2;
    ld.shared.u32   temp1, [shared_mod];
    ld.shared.u32   temp2, [shared_ex];
	add.u32		    out, temp2, temp1;
    ret;
}

.func (.reg .b32 out) set_shared_temp1(.reg .b32 temp1)
{
    st.shared.u32   [shared_ex], temp1;
    call            (out), add;
    ret;
}

.visible .entry shared_unify_extern(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp1;
    .reg .u32 	    temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.global.u32   temp1, [in_addr];
    ld.global.u32   temp2, [in_addr+8];
    st.shared.u32   [shared_mod], temp2;
    call            (temp2), set_shared_temp1, (temp1);
    st.u32          [out_addr], temp2;
	ret;
}
