.version 6.5
.target sm_30
.address_size 64

.visible .entry mul_non_ftz(
	.param .f32 input1,
	.param .f32 input2,
	.param .f32 output
)
{
    .reg .f32 	    temp1;
    .reg .f32 	    temp2;
    .reg .f32 	    result;

	ld.param.f32 	temp1, [input1];
    ld.param.f32 	temp2, [input2];
	mul.f32		result, temp1, temp2;
    st.param.f32    [output], result;
	ret;
}
