.version 6.5
.target sm_30
.address_size 64

.visible .entry cos(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .f32       temp;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.f32          temp, [in_addr];
	cos.approx.f32  temp, temp;
    st.f32          [out_addr], temp;
	ret;
}
