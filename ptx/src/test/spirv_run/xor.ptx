.version 6.5
.target sm_30
.address_size 64

.visible .entry xor(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .b32       temp1;
    .reg .b32       temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.b32          temp1, [in_addr];
    ld.b32          temp2, [in_addr+4];
	xor.b32  		temp1, temp1, temp2;
    st.b32          [out_addr], temp1;
	ret;
}
