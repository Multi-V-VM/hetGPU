.version 6.5
.target sm_30
.address_size 64

.visible .entry xor(
	.param .b32 input1,
	.param .b32 input2,
	.param .b32 output
)
{
    .reg .b32       temp1;
    .reg .b32       temp2;
    .reg .b32       result;

	ld.param.b32 	temp1, [input1];
    ld.param.b32 	temp2, [input2];
	xor.b32  		result, temp1, temp2;
    st.param.b32    [output], result;
	ret;
}
