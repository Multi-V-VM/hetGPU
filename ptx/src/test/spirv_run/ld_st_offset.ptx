.version 6.5
.target sm_30
.address_size 64

.visible .entry ld_st_offset(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u32 	    temp1;
    .reg .u32 	    temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.u32          temp1, [in_addr];
    ld.u32          temp2, [in_addr+4];
    st.u32          [out_addr], temp2;
    st.u32          [out_addr+4], temp1;
	ret;
}