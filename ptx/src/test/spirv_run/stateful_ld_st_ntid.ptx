.version 6.5
.target sm_30
.address_size 64

.visible .entry stateful_ld_st_ntid(
    .param .u32 input,
    .param .u32 output
)
{
    .reg .b32           in_addr;
    .reg .b32           out_addr;
    .reg .u32           tid_32;
    .reg .u32           tid_64;
    .reg .u32           temp;

    ld.param.u32        in_addr, [input];
    ld.param.u32        out_addr, [output];

    cvta.to.global.u32  in_addr, in_addr;
    cvta.to.global.u32  out_addr, out_addr;

    mov.u32             tid_32, %tid.x;
    cvt.u32.u32         tid_64, tid_32;

    add.u32             in_addr, in_addr, tid_64;
    add.u32             out_addr, out_addr, tid_64;

    ld.global.u32       temp, [in_addr];
    st.global.u32       [out_addr], temp;
    ret;
}