.version 6.5
.target sm_30
.address_size 64

.visible .entry or(
	.param .u32 input1,
	.param .u32 input2,
	.param .u32 output
)
{
    .reg .u32 	    temp1;
    .reg .u32 	    temp2;
    .reg .u32 	    result;

	ld.param.u32 	temp1, [input1];
    ld.param.u32 	temp2, [input2];
	or.b32		    result, temp1, temp2;
    st.param.u32    [output], result;
	ret;
}
