.version 6.5
.target sm_30
.address_size 64

.visible .entry bfe(
	.param .u32 input1,
	.param .u32 input2,
	.param .u32 input3,
	.param .u32 output
)
{
    .reg .u32       temp<3>;
    .reg .u32       result;

	ld.param.u32 	temp0, [input1];
	ld.param.u32 	temp1, [input2];
	ld.param.u32 	temp2, [input3];
	bfe.u32  		result, temp0, temp1, temp2;
    st.param.u32    [output], result;
	ret;
}
