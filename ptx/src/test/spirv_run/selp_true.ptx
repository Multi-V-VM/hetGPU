.version 6.5
.target sm_30
.address_size 64

.visible .entry selp_true(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .u16 	    temp1;
    .reg .u16 	    temp2;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.u16          temp1, [in_addr];
    ld.u16          temp2, [in_addr + 2];
    selp.u16   		temp1, temp1, temp2, 1;
    st.u16          [out_addr], temp1;
	ret;
}
