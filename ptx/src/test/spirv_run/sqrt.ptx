.version 6.5
.target sm_30
.address_size 64

.visible .entry sqrt(
	.param .u32 input,
	.param .u32 output
)
{
	.reg .u32 	    in_addr;
    .reg .u32 	    out_addr;
    .reg .f32 	    temp1;

	ld.param.u32 	in_addr, [input];
    ld.param.u32 	out_addr, [output];

    ld.f32          temp1, [in_addr];
	sqrt.approx.f32	temp1, temp1;
    st.f32          [out_addr], temp1;
	ret;
}
