// Spatial kernel: data-dependent gather-scatter.
// Each lane computes an index from data (idx = A[laneid] & 63), gathers
// B[idx] through a per-lane data-dependent load (the indexed/hybrid
// memory route -- every lane's address comes from memory, not from the
// launch configuration), and scatters the value to C[laneid].
//
// Memory layout: A at 8192 (32 words), B at 12288 (64 words), C at 16384.

.version 7.0
.target sm_70
.visible .entry gather(.param .u32 pA, .param .u32 pB, .param .u32 pC)
{
    .reg .s32 %r<20>;
    .reg .pred %p<8>;

    mov.u32  %r1, %laneid;
    ld.param.u32 %r4, pA;
    ld.param.u32 %r5, pB;
    ld.param.u32 %r6, pC;
    mov.u32  %r21, 63;
    mov.u32  %r23, 0;                 // zero offset register
    add.s32  %r12, %r4, %r1;
    ld.global.s32 %r9, [%r12];        // A[laneid]
    and.b32  %r10, %r9, %r21;         // idx = A[laneid] & 63
    add.s32  %r13, %r5, %r10;         // addr = B + idx (data-dependent)
    ld.global.s32 %r14, [%r13+%r23];  // gather
    add.s32  %r15, %r6, %r1;
    st.global.s32 [%r15], %r14;       // scatter to C[laneid]
    ret;
}
