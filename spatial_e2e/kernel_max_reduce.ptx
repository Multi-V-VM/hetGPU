// Spatial kernel: warp max-reduction. Each lane loads one element of A,
// the warp reduces with 5 (shfl.down, setp.lt, selp) steps -- the select
// keeps the larger of the lane's own value and the shuffled one -- and
// lane 0 stores the maximum into C[0]. Exercises the select path (both
// arms are data, not just predicated effects).

.version 7.0
.target sm_70
.visible .entry max_reduce(.param .u32 pA, .param .u32 pC)
{
    .reg .s32 %r<16>;
    .reg .pred %p<8>;

    mov.u32  %r1, %laneid;
    ld.param.u32 %r4, pA;
    ld.param.u32 %r6, pC;
    mov.u32  %r21, 0;
    mov.u32  %r22, 1;
    add.s32 %r12, %r4, %r1;
    ld.global.s32 %r9, [%r12];       // per-lane value
    shfl.down.b32 %r16, %r9, 16, 31, 0xffffffff;
    setp.lt.s32 %p1, %r16, %r9;
    selp.b32 %r9, %r9, %r16, %p1;
    shfl.down.b32 %r16, %r9, 8, 31, 0xffffffff;
    setp.lt.s32 %p1, %r16, %r9;
    selp.b32 %r9, %r9, %r16, %p1;
    shfl.down.b32 %r16, %r9, 4, 31, 0xffffffff;
    setp.lt.s32 %p1, %r16, %r9;
    selp.b32 %r9, %r9, %r16, %p1;
    shfl.down.b32 %r16, %r9, 2, 31, 0xffffffff;
    setp.lt.s32 %p1, %r16, %r9;
    selp.b32 %r9, %r9, %r16, %p1;
    shfl.down.b32 %r16, %r9, 1, 31, 0xffffffff;
    setp.lt.s32 %p1, %r16, %r9;
    selp.b32 %r9, %r9, %r16, %p1;
    setp.eq.s32 %p4, %r1, %r21;
    @%p4 st.global.s32 [%r6], %r9;   // lane 0 stores the max
    ret;
}
