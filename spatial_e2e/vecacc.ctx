; CTX: lane-packed mask-SSA muops lifted from PTX
; W = 32 lanes; guards are active-lane masks; memory muops carry
; state space, order, and scope; bar.sync muops are safe points.
  sreg.laneid ptx=0, dst=%r1, imm=laneid   ; mov.u32  %r1, %laneid
  ld.param   ptx=1, dst=%r25, param=pC, param_idx=0   ; ld.param.u32 %r25, pC
  ld.param   ptx=2, dst=%r26, param=pA, param_idx=1   ; ld.param.u32 %r26, pA
  ld.param   ptx=3, dst=%r27, param=pNB, param_idx=2   ; ld.param.u32 %r27, pNB
  mov        ptx=4, dst=%r22, imm=1   ; mov.u32  %r22, 1
  mov        ptx=5, dst=%r23, imm=128   ; mov.u32  %r23, 128
  mov        ptx=6, dst=%r24, imm=32   ; mov.u32  %r24, 32
  mov        ptx=7, dst=%r9, imm=0   ; mov.u32  %r9, 0
  setp.lt    ptx=8, dst=%p5, a=%r9, b=%r27   ; setp.lt.s32 %p5, %r9, %r27
  @!%p5 bra        EXIT   ; ptx:9
  mov        ptx=10, dst=%r10, imm=0   ; mov.u32  %r10, 0
  setp.lt    ptx=11, dst=%p1, a=%r10, b=%r23   ; setp.lt.s32 %p1, %r10, %r23
  @!%p1 bra        JDONE   ; ptx:12
  mad        ptx=13, dst=%r11, a=%r10, b=%r24, c=%r1   ; mad.lo.s32 %r11, %r10, %r24, %r1
  add        ptx=14, dst=%r12, a=%r25, b=%r11   ; add.s32 %r12, %r25, %r11
  ld.global  %r14, [[%r12]]  space=global order=weak   ; ld.global.s32 %r14, [%r12]
  add        ptx=16, dst=%r13, a=%r26, b=%r11   ; add.s32 %r13, %r26, %r11
  ld.global  %r15, [[%r13]]  space=global order=weak   ; ld.global.s32 %r15, [%r13]
  add        ptx=18, dst=%r14, a=%r14, b=%r15   ; add.s32 %r14, %r14, %r15
  st.global  [[%r12]], %r14  space=global order=weak   ; st.global.s32 [%r12], %r14
  add        ptx=20, dst=%r10, a=%r10, b=%r22   ; add.s32 %r10, %r10, %r22
  bra        LOOP_J   ; bra LOOP_J
  bar.sync   0     ; SAFE POINT sp:SP0
  add        ptx=23, dst=%r9, a=%r9, b=%r22   ; add.s32 %r9, %r9, %r22
  bra        LOOP_B   ; bra LOOP_B
  exit       ptx=25   ; ret
