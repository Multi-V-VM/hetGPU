// TT->spatial continuation kernel: vector-add accumulate.
// C[i] += A[i] for 4096 int32 elements; lane l owns elements l, l+32, ...,
// l+127*32. Each batch ends in bar.sync -- the safe point the runtime
// checkpoints at. NB is a launch parameter so a continuation run executes
// exactly the remaining batches of a migrated job.
//
// Memory layout (int32 words): C at pC (0), A at pA (8192).

.version 7.0
.target sm_70
.visible .entry vecacc(.param .u32 pC, .param .u32 pA, .param .u32 pNB)
{
    .reg .s32 %r<28>;
    .reg .pred %p<8>;

    mov.u32  %r1, %laneid;
    ld.param.u32 %r25, pC;
    ld.param.u32 %r26, pA;
    ld.param.u32 %r27, pNB;
    mov.u32  %r22, 1;
    mov.u32  %r23, 128;
    mov.u32  %r24, 32;
    mov.u32  %r9, 0;               // batch counter

LOOP_B:
    setp.lt.s32 %p5, %r9, %r27;
    @!%p5 bra EXIT;
    mov.u32  %r10, 0;              // j
LOOP_J:
    setp.lt.s32 %p1, %r10, %r23;
    @!%p1 bra JDONE;
    mad.lo.s32 %r11, %r10, %r24, %r1;   // elem = j*32 + laneid
    add.s32 %r12, %r25, %r11;
    ld.global.s32 %r14, [%r12];
    add.s32 %r13, %r26, %r11;
    ld.global.s32 %r15, [%r13];
    add.s32 %r14, %r14, %r15;
    st.global.s32 [%r12], %r14;
    add.s32 %r10, %r10, %r22;
    bra LOOP_J;
JDONE:
    bar.sync 0;                    // safe point per batch
    add.s32 %r9, %r9, %r22;
    bra LOOP_B;
EXIT:
    ret;
}
